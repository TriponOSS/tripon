// examples/math.tp - arithmetic (all types explicit, zero implicit conversion)

use tier core;

fn main() -> i32 {
    let int_sum = 7 + 3 * 2;
    print_i32(int_sum);          // 13: precedence is C-family, documented in grammar.ebnf

    let circle = 3.14 * 2.0 * 2.0;
    print_f64(circle);           // f64 is the default float; ** works on floats: 2.0 ** 3.0

    let half = 9 / 2;
    let rem = 9 % 2;
    print_i32(half);             // 4: int division, divides by zero -> E9003 trap, never UB
    print_i32(rem);              // 1

    return 0;
}
