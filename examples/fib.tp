// examples/fib.tp - loops, params, returns, stdlib prelude print_i32

use tier core;

fn fib(n: i32) -> i32 {
    let a = 0;
    let b = 1;
    let idx = 0;
    while idx < n {
        let next = a + b;
        a = b;
        b = next;
        idx += 1;
    }
    return a;
}

fn main() -> i32 {
    let n = 0;
    while n < 10 {
        print_i32(fib(n));
        n += 1;
    }
    return 0;
}
