use tier core;

struct Point { x: i32; y: i32; }

fn main() -> i32 {
    let a: [3]Point;
    let i = 0;
    while i < 3 {
        a[i].x = i + 1;
        a[i].y = (i + 1) * 2;
        i += 1;
    }
    i = 0;
    while i < 3 {
        print_i32(a[i].x);
        print_i32(a[i].y);
        i += 1;
    }
    print_i32(a[2].x);
    return 0;
}
