use tier core;
extern "C" { fn puts(p: str) -> i32; }

fn main() -> i32 {
    let a = 7;
    let big = cast<i64>(a);
    print_i64(big);
    let wide = big * cast<i64>(1000000000);
    print_i64(wide);
    let back = cast<i32>(wide / cast<i64>(1000000000));
    print_i32(back);
    let trunc = cast<i32>(cast<i64>(2147483650));
    print_i32(trunc);
    print_i32(cast<i32>(3.9));
    print_i32(cast<i32>(-2.5));
    let f = cast<f64>(5);
    print_f64(f);
    let half = cast<f64>(7) / 2.0;
    if half == 3.5 { puts("fdiv ok"); }
    let small = cast<i8>(100);
    print_i32(cast<i32>(small));
    small += cast<i8>(3);
    print_i32(cast<i32>(small));
    let u = cast<u32>(0);
    u += cast<u32>(7);
    if cast<i32>(u) == 7 { puts("u ok"); }
    let s16 = cast<i16>(-300);
    print_i32(cast<i32>(s16));
    return 0;
}
