use tier core;

fn main() -> i32 {
    let x = 5;
    const LIMIT = 4;
    let total = 0;
    let idx = 0;
    while idx < LIMIT {
        total = total + x;
        idx += 1;
    }
    if total == 20 { print_str("hello loop"); }
    else { print_str("bad math"); }
    print_str("done");
    return 0;
}
