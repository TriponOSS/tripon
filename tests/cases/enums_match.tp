use tier core;
enum Status { Ok, Err, Pending }
enum Res { Good(i32), Bad(str), Empty }
enum Pair { P(i32, i32), None }

fn label(s: Status) -> i32 {
    match s {
        Ok => { print_str("bare ok"); }
        Status::Err => { print_str("err"); }
        Status::Pending => { print_str("pending"); }
    }
    return 0;
}

fn show(r: Res) -> i32 {
    match r {
        Res::Good(v) => { print_i32(v); }
        Res::Bad(b) => { print_str(b); }
        Res::Empty => { }
    }
    return 0;
}

fn pair_sum(pr: Pair) -> i32 {
    match pr {
        Pair::P(a, b) => { print_i32(a + b); }
        Pair::None => { print_str("none"); }
    }
    return 0;
}

fn use_wild(x: Status) -> i32 {
    match x {
        Status::Ok => { print_str("wild ok"); }
        _ => { print_str("wild rest"); }
    }
    return 0;
}

fn main() -> i32 {
    label(Status::Pending);
    label(Status::Ok);
    show(Res::Good(41));
    show(Res::Good(42));
    show(Res::Bad("payload str"));
    show(Res::Empty);
    pair_sum(Pair::P(19, 23));
    pair_sum(Pair::None);
    use_wild(Status::Ok);
    use_wild(Status::Pending);
    let n = 0;
    match n {
        2 => { print_str("two"); }
        0 => { print_str("zero"); }
        _ => { print_str("num other"); }
    }
    let flag = true;
    match flag {
        true => { print_str("flag on"); }
        false => { print_str("flag off"); }
    }
    return 0;
}
