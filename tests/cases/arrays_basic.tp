use tier core;

fn main() -> i32 {
    let a: [5]i32;
    let i = 0;
    while i < 5 {
        a[i] = i * 10;
        i += 1;
    }
    i = 1;
    a[i] += 5;
    let sum = 0;
    i = 0;
    while i < 5 {
        sum += a[i];
        i += 1;
    }
    print_i32(sum);
    print_i32(a[0]);
    print_i32(a[4]);
    i = 2;
    print_i32(a[i]);
    print_i32(len(a));
    let b: [5]i32;
    b = a;
    print_i32(b[1]);
    return 0;
}
