// queue8 stdlib smoke: fixed-capacity FIFO ring.
use tier core;

fn main() -> i32 {
    let r = ring8_init();
    if ring8_is_empty(r) { print_str("empty yes"); }
    r = ring8_push(r, 10);
    r = ring8_push(r, 20);
    r = ring8_push(r, 30);
    print_i32(ring8_len(r));
    print_i32(unwrap_or_i32(ring8_front(r), 0 - 1));
    print_i32(ring8_sum(r));
    r = ring8_pop(r);
    print_i32(unwrap_or_i32(ring8_front(r), 0 - 1));
    print_i32(ring8_len(r));
    r = ring8_push(r, 40);
    r = ring8_push(r, 50);
    print_i32(ring8_sum(r));
    let i = 0;
    while i < 6 {
        r = ring8_push(r, i);
        i += 1;
    }
    print_i32(ring8_len(r));
    if ring8_is_full(r) { print_str("full yes"); }
    return 0;
}
