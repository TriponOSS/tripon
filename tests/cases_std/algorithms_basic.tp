// algorithms: iteration-heavy classics in pure Tripon (no recursion needed).
use tier core;

fn fib(n: i32) -> i32 {
    let a = 0;
    let b = 1;
    let i = 0;
    while i < n {
        let t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return a;
}

fn fact(n: i32) -> i32 {
    let r = 1;
    let i = 1;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn sum_to(n: i32) -> i32 {
    let s = 0;
    let i = 1;
    while i <= n {
        s += i;
        i += 1;
    }
    return s;
}

fn main() -> i32 {
    print_i32(fib(20));
    print_i32(fact(7));
    print_i32(sum_to(100));
    return 0;
}
