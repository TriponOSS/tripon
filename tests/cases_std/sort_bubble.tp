// bubble sort over a local fixed array (pattern: caller-owned, inline).
use tier core;

fn main() -> i32 {
    let a: [6]i32;
    a[0] = 5;
    a[1] = 2;
    a[2] = 8;
    a[3] = 1;
    a[4] = 9;
    a[5] = 3;
    let i = 0;
    while i < 6 {
        let j = 0;
        while j + 1 < 6 - i {
            if a[j] > a[j + 1] {
                let t = a[j];
                a[j] = a[j + 1];
                a[j + 1] = t;
            }
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while i < 6 {
        print_i32(a[i]);
        i += 1;
    }
    return 0;
}
