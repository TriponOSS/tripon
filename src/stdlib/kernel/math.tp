// stdlib/kernel/math.tp - integer math helpers (tier kernel: no alloc, no runtime).
// Pure functions over scalars. No arrays-as-params (v0 local-only), no opt/result.

use tier kernel;

fn min_i32(a: i32, b: i32) -> i32 {
    if a < b { return a; }
    return b;
}

fn max_i32(a: i32, b: i32) -> i32 {
    if a > b { return a; }
    return b;
}

fn clamp_i32(x: i32, lo: i32, hi: i32) -> i32 {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

fn abs_i32(x: i32) -> i32 {
    if x < 0 { return 0 - x; }
    return x;
}

fn min_i64(a: i64, b: i64) -> i64 {
    if a < b { return a; }
    return b;
}

fn max_i64(a: i64, b: i64) -> i64 {
    if a > b { return a; }
    return b;
}

fn clamp_i64(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

fn abs_i64(x: i64) -> i64 {
    if x < 0 { return 0 - x; }
    return x;
}

fn gcd_i32(a: i32, b: i32) -> i32 {
    let x = a;
    let y = b;
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    return x;
}

fn is_prime_i32(n: i32) -> bool {
    if n < 2 { return false; }
    if n == 2 { return true; }
    if n % 2 == 0 { return false; }
    let d = 3;
    while d * d <= n {
        if n % d == 0 { return false; }
        d += 2;
    }
    return true;
}

fn sign_i32(x: i32) -> i32 {
    if x < 0 { return 0 - 1; }
    if x > 0 { return 1; }
    return 0;
}
